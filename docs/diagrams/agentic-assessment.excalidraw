   "roundness": null,
   "seed": 780846360,
   "version": 1,
   "versionNonce": 54762750,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "In — no phone, address or identifier; names in a call become \"the buyer\"\n• rules: the business rules that fire, e.g. \"This phone has 3 of 4 past\n   orders that failed because of the buyer.\", \"The address is missing a house number.\"\n• signals: the top factors raising the risk (SHAP) with their real values\n• model probability, tier, expected loss; channel, COD amount, gift flag\n• call: the transcript as numbered lines (only after an AI call)",
   "originalText": "In — no phone, address or identifier; names in a call become \"the buyer\"\n• rules: the business rules that fire, e.g. \"This phone has 3 of 4 past\n   orders that failed because of the buyer.\", \"The address is missing a house number.\"\n• signals: the top factors raising the risk (SHAP) with their real values\n• model probability, tier, expected loss; channel, COD amount, gift flag\n• call: the transcript as numbered lines (only after an AI call)",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 16
  },
