  {
   "id": "e73",
   "type": "text",
   "x": 65,
   "y": 1105,
   "width": 866.8800000000001,
   "height": 135.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
