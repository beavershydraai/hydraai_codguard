# Local examples only. Production secrets belong in Secret Manager.
FIRESTORE_DATABASE=vn-synthetic
MODEL_DIR=.models
PHONE_HASH_KEY=replace-with-a-local-demo-secret
INTAKE_API_KEYS=demo-key:shop_la_vang
# Order simulator (python -m app.demo.simulate): the intake API it posts to.
INTAKE_URL=http://localhost:8080

# Shop app sign-in (POST /api/v1/auth/login). Sign-in is disabled unless all three are set.
# Demo account for local use only; set a different password in Secret Manager for the cloud.
ADMIN_USERNAME=admin@gmail.com
ADMIN_PASSWORD=admin12345
AUTH_TOKEN_SECRET=replace-with-a-local-signing-secret
# Optional: the admin's shop (defaults to shop_demo). The cloud uses shop_la_vang, the simulator's main shop.
ADMIN_SHOP_ID=shop_la_vang

# Leave empty to retain the deterministic pipeline without Gemini assessment.
# Set the model ID to enable the risk analyst and evidence verifier; production uses
# gemini-3.1-flash-lite (ci.yml GEMINI_ENV). Vertex AI serves it only from the global location.
GEMINI_MODEL=
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=ai-codguard
GOOGLE_CLOUD_LOCATION=global

# Shared across shops and instances: at most 30 assessment runs per UTC day.
# Each admitted run permits at most two LLM requests with transport retries disabled.
ASSESSMENT_DAILY_LIMIT=30

# AI calls (E5, docs/call-controller.md). Without CALL_JOBS_TOPIC the call endpoints answer 501
# and the pipeline keeps simulated calls. CALL_TARGET_OVERRIDE rings this softphone instead of
# the buyer (demo and testing); while it is set, the per-phone contact rules are skipped.
CALL_JOBS_TOPIC=
CALL_ENV=dev-yourname
CALL_TARGET_OVERRIDE=sip:6001
# CONTACT_HOURS=08:00-21:00
# Internal API for the call controller: skip the ID token check on your machine only.
INTERNAL_AUTH=off
