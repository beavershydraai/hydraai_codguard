# Configure with environment variables or Secret Manager; no secrets in this file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=asia-southeast1
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=10
# Per GeminiClient instance, including retries. E1.4 provides shared cap hooks.
GEMINI_MAX_CALLS=100

# Separate Live client configuration; E3 never reads these variables.
GEMINI_LIVE_MODEL=
GEMINI_LIVE_LOCATION=us-central1

BQ_DATASET=cod_guard
GHN_API_BASE_URL=
GHN_API_TOKEN=
