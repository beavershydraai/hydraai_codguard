# Copy to .env and fill in. Never commit .env; secrets live in Secret Manager.
GOOGLE_CLOUD_PROJECT=<your-project-id>
GOOGLE_CLOUD_REGION=asia-southeast1

# Gemini text calls (address check, later conversation signals and reasons).
# Unset GEMINI_MODEL = Gemini off: the address check uses its rules only.
GEMINI_MODEL=<gemini-model-id>
GEMINI_LOCATION=asia-southeast1   # `global` if the model is not served in asia-southeast1

# Gemini Live (AI call), see docs/gemini-live.md
GEMINI_LIVE_MODEL=<gemini-live-model-id>
GEMINI_LIVE_LOCATION=us-central1  # Live API is not served from asia-southeast1

# Backend data (backend/app/data/store.py, backend/app/risk/artifacts.py)
FIRESTORE_DATABASE=(default)
PHONE_HASH_KEY=<from-secret-manager>
INTAKE_API_KEYS=<key>:<shop_id>
MODEL_BUCKET=<bucket>             # or MODEL_DIR=<local folder> for local runs

BQ_DATASET=cod_guard
GHN_API_BASE_URL=<ghn-staging-url>   # optional
GHN_API_TOKEN=<from-secret-manager>  # optional, never commit
