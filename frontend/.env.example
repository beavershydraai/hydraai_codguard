# Copy to .env.local. Vite only exposes variables prefixed with VITE_ to the browser.

# API origin. Leave empty to call /api on the same origin (the dev server proxies it).
VITE_API_URL=
# Until Firebase Auth is wired (E7.1), the login page accepts any credentials and stores this
# token when it is set. Any bearer token works with the Prism mock. Never set it in production.
VITE_DEV_AUTH_TOKEN=dev-token
