# Copy to .env.local. Vite only exposes variables prefixed with VITE_ to the browser.

# API origin. Leave empty to call /api on the same origin (the dev server proxies it).
VITE_API_URL=

# In-browser mock API (src/mocks): `all` answers every request without a backend, `fallback`
# (default) only answers endpoints the backend still returns 501 for, `off` disables it.
VITE_API_MOCK=fallback
